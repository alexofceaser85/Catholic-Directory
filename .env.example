# Copy this file to .env and fill in the values.
# Never commit your real .env file.

# --- Server ---
PORT=3000
# Leave as "production" on the live server (HTTPS-only cookies, no test sign-in).
# Only an explicit "development" turns those protections off, for local testing.
NODE_ENV=production
# Set to true when running behind a reverse proxy / hosting platform (Render, Railway, nginx).
TRUST_PROXY=false

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=directory
DB_PASSWORD=change-me
DB_NAME=directory

# --- Admin sign-in ---
# Long random string used to sign admin session cookies (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# OAuth "Web application" client ID from Google Cloud Console (see docs/deployment.md).
GOOGLE_CLIENT_ID=

# Comma-separated Google account emails allowed into the admin dashboard.
ADMIN_EMAILS=admin@example.com

# Local testing only: show an email-only sign-in on /admin (still limited to ADMIN_EMAILS).
# There is NO password check, so it only works when NODE_ENV=development.
DEV_ADMIN_LOGIN=false

# --- Public address ---
# The address people use to reach the site, with no trailing slash. Used to build the private
# "manage your post" links in emails.
PUBLIC_URL=http://localhost:3000

# --- Outgoing email ---
# Posters are emailed a private link to edit, renew or remove their post. Use the Gmail API
# (GMAIL_*, required on Railway, which blocks SMTP) or any SMTP provider (MAIL_HOST...).
# See docs/deployment.md. Leave both empty while testing: emails are printed to the server log
# instead (development only).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# From `node tools/gmail-authorize.js`. When set, the Gmail API is used instead of SMTP.
GMAIL_REFRESH_TOKEN=

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Catholic Business Directory <directory@example.com>

# --- Directory rules ---
# Live business listings older than this many days since their last verification need reverifying.
# (How long services / help-wanted posts last is set in public/js/post-options.js.)
REVERIFY_AFTER_DAYS=90
